# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# For Gmail: enable "App Passwords" (not your normal password).
# For SendGrid: EMAIL_HOST=smtp.sendgrid.net, EMAIL_HOST_USER=apikey, EMAIL_HOST_PASSWORD=<api-key>
# For Mailgun: EMAIL_HOST=smtp.mailgun.org

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=Gonep Healthcare <your-gmail@gmail.com>

# Where support ticket notifications are sent (can be a team inbox)
SUPPORT_NOTIFY_EMAIL=support@yourdomain.com

# ── Portal URLs (used in email links) ─────────────────────────────────────────
GONEP_PORTAL_LOGIN_URL=https://your-provider-portal.vercel.app
GONEP_PATIENT_LOGIN_URL=https://your-patient-portal.vercel.app
